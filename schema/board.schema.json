{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-\\d+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "feature",
              "fix",
              "chore",
              "docs",
              "research",
              "review",
              "release"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "builder",
              "reviewer",
              "designer",
              "researcher",
              "release",
              "cache"
            ]
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "string",
            "enum": [
              "S",
              "M",
              "L"
            ]
          },
          "priority": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "assigned",
              "in_progress",
              "in_review",
              "queued",
              "merged",
              "blocked",
              "dropped"
            ]
          },
          "paths": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "touches": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "conflicts_with": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "component": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "components": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            }
          },
          "runs_on": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "depends_on": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dod": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "flag": {
            "type": "string"
          },
          "owner_only": {
            "type": "boolean"
          },
          "plan": {
            "type": "string"
          },
          "pr": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "branch": {
            "type": "string"
          },
          "approved_head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40,64}$"
          },
          "approved_base": {
            "type": "string",
            "minLength": 1
          },
          "approved_jobs": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "workflow": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
                },
                "job": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
                }
              },
              "required": [
                "workflow",
                "job"
              ],
              "additionalProperties": false
            }
          },
          "not_run_here": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
                },
                "missing": {
                  "type": "string",
                  "enum": [
                    "database",
                    "docker",
                    "network",
                    "service"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
                }
              },
              "required": [
                "command",
                "missing",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "crew": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risk": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ui",
                "landing",
                "auth",
                "security",
                "data",
                "migration"
              ]
            }
          },
          "triggers": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "epic-end",
                "release"
              ]
            }
          },
          "model": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:[\\]-]*$"
          },
          "finding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
          },
          "artifacts": {
            "type": "string",
            "minLength": 2,
            "maxLength": 500,
            "pattern": "^\\/[^\\p{Cc}\\p{Cf}]*$"
          },
          "epic": {
            "type": "string",
            "pattern": "^E-[1-9]\\d*$"
          },
          "usage": {
            "type": "object",
            "properties": {
              "runs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tokens_in": {
                "type": "number",
                "minimum": 0
              },
              "tokens_out": {
                "type": "number",
                "minimum": 0
              },
              "tokens_cache": {
                "type": "number",
                "minimum": 0
              },
              "cost_usd": {
                "type": "number",
                "minimum": 0
              },
              "estimated": {
                "type": "boolean"
              }
            },
            "required": [
              "runs",
              "tokens_in",
              "tokens_out",
              "cost_usd"
            ],
            "additionalProperties": false
          },
          "history": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string"
                },
                "from": {
                  "type": "string",
                  "enum": [
                    "ready",
                    "assigned",
                    "in_progress",
                    "in_review",
                    "queued",
                    "merged",
                    "blocked",
                    "dropped"
                  ]
                },
                "to": {
                  "type": "string",
                  "enum": [
                    "ready",
                    "assigned",
                    "in_progress",
                    "in_review",
                    "queued",
                    "merged",
                    "blocked",
                    "dropped"
                  ]
                },
                "by": {
                  "type": "string"
                }
              },
              "required": [
                "at",
                "from",
                "to",
                "by"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "role",
          "repo",
          "size",
          "priority",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^E-[1-9]\\d*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "accepting",
              "done",
              "dropped"
            ]
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
          },
          "acceptance": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            }
          },
          "components": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            }
          },
          "imported_from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
          },
          "notes": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
            }
          },
          "member_items": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^([a-z][a-z0-9-]{0,31}):([A-Z]+-\\d+)$"
            }
          },
          "accepted": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "pattern": "^[A-Z]+-\\d+$"
              },
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40,64}$"
              },
              "at": {
                "type": "string"
              }
            },
            "required": [
              "item",
              "sha",
              "at"
            ],
            "additionalProperties": false
          },
          "history": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "at": {
                  "type": "string"
                },
                "from": {
                  "type": "string",
                  "enum": [
                    "open",
                    "accepting",
                    "done",
                    "dropped"
                  ]
                },
                "to": {
                  "type": "string",
                  "enum": [
                    "open",
                    "accepting",
                    "done",
                    "dropped"
                  ]
                },
                "by": {
                  "type": "string"
                }
              },
              "required": [
                "at",
                "from",
                "to",
                "by"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "goal",
          "acceptance"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
