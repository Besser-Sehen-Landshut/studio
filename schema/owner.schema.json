{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "crew_toolchain_paths": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "crew_credential_command": {
      "type": "string",
      "minLength": 1
    },
    "allow_api_billing": {
      "default": false,
      "type": "boolean"
    },
    "allow_proof_commands": {
      "default": false,
      "type": "boolean"
    },
    "crew_allow_macos_trust_service": {
      "default": false,
      "type": "boolean"
    },
    "crew_label_limits": {
      "default": {
        "max_parallel": 2
      },
      "type": "object",
      "properties": {
        "max_parallel": {
          "default": 2,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_runs_per_day": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timezone": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "allowed_plugins": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "marketplace": {
            "type": "string",
            "pattern": "^https:\\/\\/github\\.com\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+(\\.git)?$"
          }
        },
        "required": [
          "name",
          "marketplace"
        ],
        "additionalProperties": false
      }
    },
    "research_roots": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "rea_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "research": {
      "default": {
        "trust": true
      },
      "type": "object",
      "properties": {
        "trust": {
          "default": true,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "rea_env": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 500
      }
    },
    "notify": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "quiet": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d-([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "timezone": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "pattern": "^(?:auto|[a-z]{2,3})$"
        },
        "ntfy_server": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "pane": {
      "type": "object",
      "properties": {
        "nested_worktrees": {
          "default": "show",
          "type": "string",
          "enum": [
            "show",
            "hide"
          ]
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "daily_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "properties": {
        "max_gb": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        }
      },
      "additionalProperties": false
    },
    "groups": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "main": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "projects": {
            "minItems": 2,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,31}$"
                },
                "repo": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
                },
                "dir": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "contracts": {
                  "minItems": 1,
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "repo",
                "dir"
              ],
              "additionalProperties": false
            }
          },
          "reference": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contracts": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reference_max_kib": {
            "default": 256,
            "type": "integer",
            "minimum": 16,
            "maximum": 2048
          }
        },
        "required": [
          "name",
          "main",
          "projects",
          "reference"
        ],
        "additionalProperties": false
      }
    },
    "workers": {
      "type": "object",
      "properties": {
        "accept": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "additionalProperties": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "login": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
                },
                "id": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "login",
                "id"
              ],
              "additionalProperties": false
            }
          }
        },
        "self": {
          "type": "object",
          "properties": {
            "lead": {
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
            },
            "lead_id": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "deny": {
              "default": {
                "paths": [],
                "ports": [],
                "hosts": []
              },
              "type": "object",
              "properties": {
                "paths": {
                  "default": [],
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 500,
                    "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
                  }
                },
                "ports": {
                  "default": [],
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                },
                "hosts": {
                  "default": [],
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 253
                  }
                },
                "prefixes": {
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 64
                  }
                }
              },
              "additionalProperties": false
            },
            "allow_read": {
              "default": [],
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 2,
                "maxLength": 500,
                "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
              }
            },
            "lease_minutes": {
              "default": 30,
              "type": "integer",
              "minimum": 10,
              "maximum": 240
            },
            "windows": {
              "type": "object",
              "properties": {
                "crew_user": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,12}$"
                }
              },
              "required": [
                "crew_user"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "lead",
            "lead_id"
          ],
          "additionalProperties": false
        },
        "relay": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "maxLength": 253,
                "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$|^[0-9A-Fa-f:]{2,39}$"
              },
              "user": {
                "default": "studio-relay",
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,19}$"
              },
              "port": {
                "default": 22,
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "host_key": {
                "type": "string",
                "pattern": "^(ssh-ed25519|ecdsa-sha2-nistp256|ecdsa-sha2-nistp384|ecdsa-sha2-nistp521|rsa-sha2-256|rsa-sha2-512|ssh-rsa) [A-Za-z0-9+/]{40,2000}={0,2}$"
              },
              "identity_file": {
                "type": "string",
                "minLength": 2,
                "maxLength": 500
              },
              "accept_no_firewall": {
                "type": "boolean"
              },
              "grace_minutes": {
                "default": 30,
                "type": "integer",
                "minimum": 5,
                "maximum": 1440
              }
            },
            "required": [
              "host",
              "host_key",
              "identity_file"
            ],
            "additionalProperties": false
          }
        },
        "serve": {
          "type": "object",
          "properties": {
            "deny": {
              "default": {
                "paths": [],
                "ports": [],
                "hosts": []
              },
              "type": "object",
              "properties": {
                "paths": {
                  "default": [],
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 500,
                    "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
                  }
                },
                "ports": {
                  "default": [],
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                },
                "hosts": {
                  "default": [],
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 253
                  }
                },
                "prefixes": {
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 64
                  }
                }
              },
              "additionalProperties": false
            },
            "allow_read": {
              "default": [],
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 2,
                "maxLength": 500,
                "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
              }
            },
            "windows": {
              "type": "object",
              "properties": {
                "crew_user": {
                  "default": "studio-crew",
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,12}$"
                },
                "broker": {
                  "default": "Studio relay broker",
                  "type": "string",
                  "pattern": "^[A-Za-z0-9 _-]{1,64}$"
                }
              },
              "additionalProperties": false
            },
            "max_cpu_percent": {
              "default": 75,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "min_free_disk_gb": {
              "default": 20,
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            },
            "probe_unreachable": {
              "default": [],
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9.:[\\]-]{1,253}:\\d{1,5}$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
