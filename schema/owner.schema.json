{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "crew_toolchain_paths": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "crew_credential_command": {
      "type": "string",
      "minLength": 1
    },
    "allow_api_billing": {
      "default": false,
      "type": "boolean"
    },
    "crew_allow_macos_trust_service": {
      "default": false,
      "type": "boolean"
    },
    "crew_label_limits": {
      "default": {
        "max_parallel": 2
      },
      "type": "object",
      "properties": {
        "max_parallel": {
          "default": 2,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_runs_per_day": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timezone": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "allowed_plugins": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "marketplace": {
            "type": "string",
            "pattern": "^https:\\/\\/github\\.com\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+(\\.git)?$"
          }
        },
        "required": [
          "name",
          "marketplace"
        ],
        "additionalProperties": false
      }
    },
    "notify": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "quiet": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d-([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "timezone": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "enum": [
            "en",
            "de"
          ]
        },
        "ntfy_server": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "daily_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "workers": {
      "type": "object",
      "properties": {
        "accept": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "additionalProperties": {
            "minItems": 1,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
            }
          }
        },
        "self": {
          "type": "object",
          "properties": {
            "lead": {
              "type": "string",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$"
            },
            "deny": {
              "default": {
                "paths": [],
                "ports": []
              },
              "type": "object",
              "properties": {
                "paths": {
                  "default": [],
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 500,
                    "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
                  }
                },
                "ports": {
                  "default": [],
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              },
              "additionalProperties": false
            },
            "lease_minutes": {
              "default": 30,
              "type": "integer",
              "minimum": 10,
              "maximum": 240
            }
          },
          "required": [
            "lead"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
