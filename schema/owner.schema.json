{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "crew_toolchain_paths": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "crew_credential_command": {
      "type": "string",
      "minLength": 1
    },
    "allow_api_billing": {
      "default": false,
      "type": "boolean"
    },
    "crew_label_limits": {
      "default": {
        "maxParallel": 2
      },
      "type": "object",
      "properties": {
        "max_parallel": {
          "default": 2,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_runs_per_day": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timezone": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
