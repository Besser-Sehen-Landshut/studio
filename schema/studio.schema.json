{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "studio": {
      "type": "number",
      "const": 1
    },
    "primary_repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
    },
    "repos": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
      }
    },
    "notify": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "owner_only": {
          "type": "boolean"
        },
        "irreversible_announce": {
          "type": "boolean"
        }
      },
      "required": [
        "channel",
        "owner_only",
        "irreversible_announce"
      ],
      "additionalProperties": false
    },
    "ci": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "const": "github"
        },
        "runners": {
          "type": "string",
          "enum": [
            "github-hosted",
            "self-hosted",
            "both"
          ]
        },
        "runner_labels": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runner_name_pattern": {
          "type": "string"
        },
        "shared_host": {
          "type": "boolean"
        },
        "github_hosted_limit": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "capacity": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "merge_max_busy": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "check_twice_seconds": {
              "type": "number",
              "minimum": 0
            },
            "host_load_max": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "total",
            "merge_max_busy",
            "check_twice_seconds"
          ],
          "additionalProperties": false
        },
        "rhythm": {
          "type": "object",
          "properties": {
            "build_window": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            }
          },
          "required": [
            "build_window",
            "timezone"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "provider",
        "runners",
        "capacity"
      ],
      "additionalProperties": false
    },
    "merge": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "studio-queue",
            "native-queue"
          ]
        },
        "contract_paths": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "method": {
          "default": "merge",
          "type": "string",
          "enum": [
            "merge",
            "squash",
            "rebase"
          ]
        }
      },
      "required": [
        "strategy"
      ],
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "builder",
          "reviewer",
          "designer",
          "researcher",
          "release"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:[\\]-]*$"
          },
          "types": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "feature",
                "fix",
                "chore",
                "docs",
                "research",
                "review",
                "release"
              ]
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:[\\]-]*$"
            }
          },
          "escalate_to": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:[\\]-]*$"
          },
          "wip": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "skills": {
            "default": {
              "required": [],
              "allowed": [],
              "denied": []
            },
            "type": "object",
            "properties": {
              "required": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "allowed": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "denied": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "when": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "paths": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "item_types": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "feature",
                          "fix",
                          "chore",
                          "docs",
                          "research",
                          "review",
                          "release"
                        ]
                      }
                    },
                    "required": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "allowed": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "model",
          "wip"
        ],
        "additionalProperties": false
      }
    },
    "stacks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sandbox": {
      "default": {
        "network_allow": []
      },
      "type": "object",
      "properties": {
        "network_allow": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "crew_token": {
      "type": "object",
      "properties": {
        "env": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "env"
      ],
      "additionalProperties": false
    },
    "allow_ambient_credentials": {
      "default": false,
      "type": "boolean"
    },
    "owner_only": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deploy_commands": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "crew_allowed_workflows": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "crew_allowed_workflow_refs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_bases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
          },
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "wip": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "repo",
          "paths"
        ],
        "additionalProperties": false
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9A-Za-z][0-9A-Za-z.+-]{0,63}$"
          },
          "marketplace": {
            "type": "string",
            "pattern": "^https:\\/\\/github\\.com\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+(\\.git)?$"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "daily_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "suites": {
          "minItems": 1,
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "workflow": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
              },
              "job": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
              }
            },
            "required": [
              "workflow",
              "job"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "suites"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "studio",
    "primary_repo",
    "repos",
    "ci",
    "merge",
    "roles"
  ],
  "additionalProperties": false
}
