{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "rules": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "git",
              "plugin",
              "skill"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https:\\/\\/github\\.com\\/[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "vendored": {
            "type": "boolean"
          },
          "notice": {
            "type": "string"
          },
          "reads": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "license",
          "vendored",
          "reads"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "sources"
  ],
  "additionalProperties": false
}
