{
  "name": "studio",
  "version": "0.5.0",
  "description": "Run a software studio of coding-agent sessions from one control room",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.7.0",
  "scripts": {
    "test": "vitest run",
    "test:mod": "node scripts/test-mod.mjs",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/bundle.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/gen-schema.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@types/shell-quote": "^1.7.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "execa": "^10.2.1",
    "shell-quote": "^1.12.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
